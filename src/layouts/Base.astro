---
const { title = 'Kuldz', wide = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- bump ?v= when the icon changes; browsers cache favicons hard -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline>
      // Easter egg: a 1 in 4747 chance per visit of seeing the site in Comic Sans ("?comic" forces it).
      // "?comic" only affects that one page view and is never remembered; only the random roll is.
      var on = new URLSearchParams(location.search).has('comic');
      try {
        var roll = sessionStorage.getItem('comic');
        if (roll === null) {
          roll = Math.random() < 1 / 4747 ? '1' : '0';
          sessionStorage.setItem('comic', roll);
        }
        on = on || roll === '1';
      } catch (e) {}
      if (on) document.documentElement.classList.add('comic');
    </script>
  </head>
  <body class:list={{ wide }}>
    <header>
      <a class="brand" href="/">Kuldz</a>
      <nav>
        <a href="/games">Games</a>
        <a href="/backlog">Backlog</a>
        <a href="/masterpieces">Masterpieces</a>
        <a href="/setup">Setup</a>
        <span class="sep" aria-hidden="true"></span>
        <a href="/pokedex">Pokédex</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer>© Kuldz · <a href="https://docs.google.com/spreadsheets/d/1ICIoxSlUR9LZJMr_RaHG2F1pBWHZuN8obxa_XUttOIk" target="_blank" rel="noopener">Sheet</a></footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0f1115;
    --fg: #e6e6e6;
    --muted: #8b93a1;
    --card: #181b22;
    --accent: #22d3ee; /* cyan, same as the favicon */
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scrollbar-gutter: stable; } /* short pages keep the same width as long ones, so content doesn't shift sideways */
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: ui-monospace, 'Cascadia Code', Menlo, monospace;
    line-height: 1.5;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  header, main, footer { max-width: 60rem; margin: 0 auto; padding: 1rem; }
  .wide :is(header, main, footer) { max-width: 90rem; } /* picture grids (Pokédex) use more of a wide screen */
  header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1.5rem; }
  header nav { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 1rem; }
  /* Divider between the spreadsheet pages and separate projects (Pokédex) */
  header nav .sep { width: 1px; height: 1em; background: var(--muted); opacity: 0.5; }
  .brand { font-weight: bold; font-size: 1.25rem; }
  footer { color: var(--muted); font-size: 0.85rem; }
  :root.comic body { font-family: 'Comic Sans MS', 'Comic Sans', 'Chalkboard SE', 'Comic Neue', cursive; }

  @media (max-width: 40rem) {
    header nav { font-size: 0.9rem; gap: 0.25rem 0.85rem; }
    header nav .sep { display: none; } /* the line break already separates the groups */
  }
</style>
