---
import Base from '../layouts/Base.astro';
import pokedex from '../data/pokedex.json'; // written by scripts/fetch-pokedex.mjs

// Ring colours like Poke Genie's Pokédex: one colour per type, two-type Pokémon get both.
const typeColor: Record<string, string> = {
  normal: '#a8a77a', fire: '#ee8130', water: '#6390f0', electric: '#f7d02c', grass: '#7ac74c', ice: '#96d9d6',
  fighting: '#c22e28', poison: '#a33ea1', ground: '#e2bf65', flying: '#a98ff3', psychic: '#f95587', bug: '#a6b91a',
  rock: '#b6a136', ghost: '#735797', dragon: '#6f35fc', dark: '#705746', steel: '#b7b7ce', fairy: '#d685ad',
};
const ring = (types: string[]) => {
  const [a, b = a] = types.map((t) => typeColor[t] ?? '#8b93a1');
  return a ? `linear-gradient(${a}, ${b})` : '#2a2f3a';
};

// "Galarian Articuno" -> "Galarian", "Zacian (Crowned Sword)" -> "Crowned Sword", "Articuno" -> ""
const formOf = (label: string, name: string) => label.replace(name, '').replace(/[()]/g, '').replace(/\s+/g, ' ').trim();

const owned =pokedex.filter((s) => s.entries.length).length;
const released = pokedex.filter((s) => s.released).length;
---

<Base title="Pokédex – Kuldz" wide>
  <Fragment slot="head">
    <!-- Lato is the font Pokémon GO's own interface uses -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&display=swap" rel="stylesheet" />
  </Fragment>
  <h1>Pokédex</h1>
  <p class="intro">
    WIP and updated once per whenever. Based off of the images that I have set in Poke Genie, which are not very organised
    since I haven't messed around with the app that much yet. I
    currently have 890 entries in the normal Pokédex. Otherwise the goal is to get the coolest possible
    pictures here, whether it's combos like costume + background or lucky + shiny. The game in question is Pokémon GO. If a picture doesn't have the usual white bar at the bottom, it's
    probably a screenshot from the Pokédex (I've obviously evolved or traded away some shinies, for example).
  </p>
  <details class="legend">
    <summary>Legend</summary>
    <ul>
      <li>Pokémon is the wrong colour and has sparkles around it <b>Shiny</b></li>
      <li>Blinding yellow glow in the background <b>Lucky</b></li>
      <li>Bigger than its own evolution / smaller than its pre-evolution <b>XXL / XXS</b></li>
      <li>Reddish aura and clouds above its head <b>Dynamax</b></li>
      <li>Who even is this? <b>Gigantamax</b></li>
      <li>Pokémon is stinky and has evil eyes <b>Shadow</b></li>
      <li>Shadow Pokémon with wasted potential (white smoke) <b>Purified</b></li>
      <li>TF2 hat or other cosmetics <b>Costume</b></li>
      <li>Cooler-than-usual scenery behind the Pokémon <b>Background</b></li>
    </ul>
  </details>
  <div class="bar">
    <div class="left">
      <p class="stats">{owned} / {released} released · {pokedex.length.toLocaleString('en')} total</p>
      <div class="toggles">
        <button id="hide-unreleased" class="toggle" type="button" aria-pressed="false">Hide unreleased</button>
        <button id="hide-completed" class="toggle" type="button" aria-pressed="false">Hide completed</button>
      </div>
    </div>
    <input id="search" type="search" placeholder="Search…" aria-label="Search by name or number" />
  </div>

  <ul class="dex">
    {pokedex.map((s) => {
      const first = s.entries[0];
      // What "Hide completed" searches: the whole species if there's no picture, otherwise only its "?" forms.
      const missingForms = s.entries.filter((e) => !e.file).map((e) => e.label);
      const missing = !first ? `${s.number} ${s.name}` : missingForms.length ? [s.number, ...missingForms].join(' ') : undefined;
      return (
        <li class:list={{ missing: !first, unreleased: !s.released }} data-search={[s.number, s.name, ...s.entries.filter((e) => e.file).map((e) => e.label)].join(' ').toLowerCase()} data-missing={missing?.toLowerCase()}>
          {s.entries.length > 1 ? (
            // Several forms (e.g. Mega): clicking the picture cycles through them, forms not pictured yet show "?".
            // All forms' pictures are stacked in the tile and only the current one is shown, so switching is instant.
            <button type="button" class="ring" style={`--ring:${ring(first.types)}`} data-entries={JSON.stringify(s.entries.map((e) => ({ form: formOf(e.label, s.name) || 'Normal', ring: ring(e.types), missing: !e.file })))} aria-label={`${first.label}, show other forms`}>
              {s.entries.map((e, i) =>
                e.file ? <img src={e.file} alt="" loading="lazy" class:list={['face', { hidden: i > 0 }]} />
                : <span class:list={['face unknown', { hidden: i > 0 }]} aria-hidden="true">?</span>,
              )}
              <span class="forms" aria-hidden="true">{formOf(first.label, s.name) || 'Normal'}</span>
            </button>
          ) : (
            <span class="ring" style={`--ring:${s.released ? ring(first?.types ?? s.types) : '#2a2f3a'}`}>
              {first ? <img src={first.file} alt="" loading="lazy" /> : <span class="unknown" aria-hidden="true">{s.released ? '?' : ''}</span>}
              {first && formOf(first.label, s.name) && <span class="forms single">{formOf(first.label, s.name)}</span>}
            </span>
          )}
          <span class="name">{s.name}</span>
          <span class="num">#{s.number}</span>
        </li>
      );
    })}
  </ul>
</Base>

<script>
  // Each multi-form tile gets a show(i) function; "Hide completed" uses it to jump to the first missing form.
  const showForm = new Map<HTMLButtonElement, (i: number) => void>();
  const missingForms = new Map<HTMLButtonElement, { i: number; form: string }[]>();
  for (const button of document.querySelectorAll<HTMLButtonElement>('button.ring')) {
    const entries: { form: string; ring: string; missing: boolean }[] = JSON.parse(button.dataset.entries!);
    const imgs = [...button.querySelectorAll('.face')];
    const badge = button.querySelector('.forms')!;
    let i = 0;
    const show = (next: number) => {
      imgs[i].classList.add('hidden');
      i = next;
      imgs[i].classList.remove('hidden');
      button.style.setProperty('--ring', entries[i].ring);
      badge.textContent = entries[i].form;
      badge.classList.toggle('single', entries[i].missing); // grey badge for a form not pictured yet
    };
    button.addEventListener('click', () => show((i + 1) % entries.length));
    showForm.set(button, show);
    const missing = entries.flatMap((e, i) => (e.missing ? [{ i, form: e.form.toLowerCase() }] : []));
    if (missing.length) missingForms.set(button, missing);
  }
  // With "Hide completed" on, show the missing form instead of a picture you already have,
  // preferring one that matches the search ("mega" on Slowbro shows Mega, not Galarian).
  function jumpToMissing(on: boolean, q: string) {
    for (const [button, missing] of missingForms) {
      showForm.get(button)!(on ? (missing.find((m) => q && m.form.includes(q)) ?? missing[0]).i : 0);
    }
  }

  // Search by name, form ("mega", "alolan") or number. A number matches exactly, so "15" doesn't show #150.
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const tiles = [...document.querySelectorAll<HTMLElement>('.dex li')];
  // "Hide completed" leaves only species with something not pictured yet, and the search then looks through
  // what's missing ("mega" = megas still needed).
  const hideUnreleased = document.querySelector<HTMLButtonElement>('#hide-unreleased')!;
  const hideCompleted = document.querySelector<HTMLButtonElement>('#hide-completed')!;
  const pressed = (b: HTMLButtonElement) => b.getAttribute('aria-pressed') === 'true';
  function filter() {
    const q = search.value.trim().toLowerCase().replace(/^#/, '');
    if (pressed(hideCompleted)) jumpToMissing(true, q);
    for (const li of tiles) {
      const text = pressed(hideCompleted) ? li.dataset.missing : li.dataset.search;
      const matches = text !== undefined && (!q || (/^\d+$/.test(q) ? text.split(' ')[0] === q : text.includes(q)));
      li.hidden = !matches || (pressed(hideUnreleased) && li.classList.contains('unreleased'));
    }
  }
  search.addEventListener('input', filter);
  for (const b of [hideUnreleased, hideCompleted]) {
    b.addEventListener('click', () => {
      b.setAttribute('aria-pressed', String(!pressed(b)));
      if (b === hideCompleted && !pressed(b)) jumpToMissing(false, ''); // back to the pictures
      filter();
    });
  }
</script>

<style>
  /* Lato for the page content only; the header and footer keep the site's font. */
  :global(main) { font-family: Lato, system-ui, sans-serif; }
  :global(:root.comic main) { font-family: inherit; }
  :global(h1) { font-weight: 900; }
  .stats { color: var(--muted); font-size: 1rem; margin: 0.25rem 0; }
  /* Count on the left, search on the right; on phones the search takes the full width under the count. */
  /* Closed by default so the grid doesn't move. Game-style cards: your description first, the term underneath as the punchline.
     9 entries: one row of 9 on wide screens (lined up with the Pokédex columns), 3 x 3 everywhere else. */
  .legend { margin: 0 0 0.75rem; }
  .legend summary { cursor: pointer; color: var(--accent); width: fit-content; -webkit-tap-highlight-color: transparent; }
  .legend ul { list-style: none; margin: 0.5rem 0 0; padding: 0; display: grid; gap: 0.5rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (min-width: 84rem) { .legend ul { grid-template-columns: repeat(9, minmax(0, 1fr)); } }
  .legend li {
    display: flex; flex-direction: column; justify-content: space-between; gap: 0.35rem; text-align: center;
    background: var(--card); border-radius: 0.6rem; padding: 0.6rem; font-size: 0.8rem; color: var(--muted);
  }
  .legend b { color: var(--fg); text-transform: uppercase; letter-spacing: 0.03em; font-size: 0.85rem; }
  @media (max-width: 40rem) { .legend li { padding: 0.5rem 0.35rem; } .legend b { font-size: 0.72rem; letter-spacing: 0; } }
  @media (max-width: 22rem) { .legend b { font-size: 0.64rem; } } /* very small phones */
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.25rem; }
  /* Count + filter buttons on the left (all about the whole list), search on the right */
  .left { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; }
  /* The two buttons wrap as a pair, so one never ends up alone next to the count */
  .toggles { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  /* Same pill style as the filter buttons on the Games page */
  .toggle {
    flex: none; font: inherit; cursor: pointer; white-space: nowrap; -webkit-tap-highlight-color: transparent;
    background: var(--card); color: var(--muted); border: 1px solid #2a2f3a; border-radius: 999px; padding: 0.4rem 0.9rem;
  }
  .toggle[aria-pressed='true'] { color: var(--bg); background: var(--accent); border-color: var(--accent); }
  #search {
    flex: 0 1 18rem; min-width: 0; font: inherit; color: var(--fg);
    background: var(--card); border: 1px solid #2a2f3a; border-radius: 0.35rem; padding: 0.45rem 0.7rem;
  }
  .dex li[hidden] { display: none; }
  .intro { font-size: 1.05rem; line-height: 1.55; margin: 0.25rem 0 0.75rem; text-wrap: pretty; } /* no lone word on the last line */
  .dex {
    --r: 1.5rem; /* tile corner radius */
    list-style: none; padding: 0; margin: 1.25rem 0 0;
    display: grid; gap: 1.5rem 1rem;
    /* Fixed column counts chosen so the 1025 entries don't end on a lonely last row:
       5 columns divide evenly, 7 leaves 3, 9 leaves 8 (and phones: 3 leaves 2). */
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }
  @media (min-width: 64rem) { .dex { grid-template-columns: repeat(7, minmax(0, 1fr)); } }
  @media (min-width: 84rem) { .dex { grid-template-columns: repeat(9, minmax(0, 1fr)); } }
  .dex li { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ring {
    position: relative; width: 100%; max-width: 8.5rem; aspect-ratio: 1; border-radius: var(--r); padding: 4px; border: 0;
    background: var(--ring);
  }
  /* No blue tap flash on phones; keyboard focus still gets a rounded outline. */
  button.ring { cursor: pointer; -webkit-tap-highlight-color: transparent; }
  button.ring:focus { outline: none; }
  button.ring:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  /* Inner corners = outer corners minus the 4px border, so the curves sit evenly inside each other.
     No background on the pictures: it would show as a dark sliver along the curved edge. */
  .ring img, .unknown { display: block; width: 100%; height: 100%; border-radius: calc(var(--r) - 4px); object-fit: cover; }
  .unknown { background: var(--card); }
  /* Stacked form pictures: hidden ones still load and stay decoded, so showing one is instant. */
  button.ring .face { position: absolute; inset: 4px; width: calc(100% - 8px); height: calc(100% - 8px); }
  button.ring .face.hidden { visibility: hidden; }
  .unknown { display: grid; place-items: center; font-size: 2.25rem; font-weight: bold; color: var(--muted); }
  .forms {
    position: absolute; left: 50%; bottom: -0.35rem; transform: translateX(-50%); white-space: nowrap;
    font-size: 0.65rem; font-weight: bold; line-height: 1.3;
    background: var(--accent); color: var(--bg); border-radius: 999px; padding: 0.1rem 0.45rem;
  }
  /* Quieter badge: a lone form (e.g. only a Galarian one) isn't clickable, and a "?" form isn't pictured yet. */
  .forms.single { background: #2a2f3a; color: var(--fg); }
  .ring { position: relative; }
  .name { margin-top: 0.5rem; font-size: 1.05rem; font-weight: bold; overflow-wrap: anywhere; }
  .num { color: var(--muted); font-size: 0.85rem; }
  .missing .name { color: var(--muted); font-weight: normal; }
  .unreleased .unknown { background: #000; }
  .unreleased .name, .unreleased .num { color: #4a505c; }

  @media (max-width: 40rem) {
    #search { flex-basis: 100%; }
    .left { justify-content: center; flex-basis: 100%; }
    .stats { flex-basis: 100%; text-align: center; }
    .toggles { flex-basis: 100%; flex-wrap: nowrap; }
    .toggle { flex: 1; padding-inline: 0.5rem; }
    .dex { --r: 1.1rem; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 0.5rem; }
    .ring { width: 100%; max-width: 6rem; }
    .name { font-size: 0.75rem; }
  }
</style>
