---
import Base from '../layouts/Base.astro';
import { getGames } from '../lib/sheet';
import '../styles/list.css';

const games = await getGames();
const completed = games.filter((g) => g.complete).length;
const achievements = games.reduce((sum, g) => sum + g.earned, 0);
const platinums = games.filter((g) => g.platinum).length;

// Text with bare URLs -> parts, so links render as real anchors.
const linkify = (text: string) =>
  text.split(/(https?:\/\/\S+)/g).map((part) => ({ part, isUrl: /^https?:\/\//.test(part) }));
---

<Base title="Games – Kuldz">
  <h1>games</h1>
  <p class="stats">
    {games.length} games · {completed} at 100% · {platinums} platinum · {achievements.toLocaleString('en')} achievements
  </p>

  <div class="controls">
    <input id="search" type="search" placeholder="search…" aria-label="Search games" />
    <select id="sort" aria-label="Sort by">
      <option value="recent">last played</option>
      <option value="name">name</option>
      <option value="pct">completion</option>
      <option value="earned">achievements earned</option>
    </select>
    <div class="chips" role="group" aria-label="Filter">
      <button type="button" data-filter="all" aria-pressed="true">all</button>
      <button type="button" data-filter="complete" aria-pressed="false">100%</button>
      <button type="button" data-filter="progress" aria-pressed="false">in progress</button>
      <button type="button" data-filter="ongoing" aria-pressed="false">ongoing</button>
    </div>
    <div class="chips" role="group" aria-label="Platform">
      <button type="button" data-platform="all" aria-pressed="true">any platform</button>
      <button type="button" data-platform="pc" aria-pressed="false">pc</button>
      <button type="button" data-platform="playstation" aria-pressed="false">playstation</button>
      <button type="button" data-platform="other" aria-pressed="false">other</button>
    </div>
    <label class="group-toggle"><input id="group" type="checkbox" /> group by franchise</label>
  </div>
  <p id="count" class="stats" aria-live="polite"></p>

  <div id="games" class="list">
    {games.map((g) => (
      <details
        class="game"
        data-name={g.name.toLowerCase()}
        data-ts={g.lastPlayedTs}
        data-pct={g.percent}
        data-earned={g.earned}
        data-franchise={g.franchise}
        data-complete={g.complete}
        data-ongoing={g.ongoing}
        data-platform={g.platform}
      >
        <summary>
          {g.icon ? <img src={g.icon} alt="" loading="lazy" class="icon" /> : <span class="icon placeholder" aria-hidden="true">{g.name[0]}</span>}
          <span class="name">{g.name}{g.ongoing && <span class="tag">ongoing</span>}{g.platform === 'playstation' && <span class="tag ps">ps</span>}{g.platinum && <span class="tag plat">platinum</span>}</span>
          <span class="count">{g.achievements || '–'}</span>
          <span class:list={['pct', { done: g.complete }]}>{g.complete ? '100%' : g.percent >= 0 ? `${g.percent}%` : ''}</span>
          <span class="date">{g.lastPlayed}</span>
        </summary>
        <div class="body">
          {g.franchise && <p class="franchise">{g.franchise}</p>}
          {g.notes && (
            <p class="notes">
              {linkify(g.notes).map((s) => (s.isUrl ? <a href={s.part} rel="noopener">{s.part}</a> : s.part))}
            </p>
          )}
          {g.review && <p class="review">{g.review}</p>}
        </div>
      </details>
    ))}
  </div>
</Base>

<script>
  const list = document.querySelector<HTMLElement>('#games')!;
  const rows = [...list.querySelectorAll<HTMLElement>('.game')];
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const sort = document.querySelector<HTMLSelectElement>('#sort')!;
  const group = document.querySelector<HTMLInputElement>('#group')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const platformChips = [...document.querySelectorAll<HTMLButtonElement>('[data-platform]')];
  const count = document.querySelector<HTMLElement>('#count')!;
  let filter = 'all';
  let platform = 'all';

  const num = (el: HTMLElement, key: string) => Number(el.dataset[key]);
  const comparators: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
    recent: (a, b) => num(b, 'ts') - num(a, 'ts'),
    name: (a, b) => a.dataset.name!.localeCompare(b.dataset.name!),
    pct: (a, b) => num(b, 'pct') - num(a, 'pct') || num(b, 'earned') - num(a, 'earned'),
    earned: (a, b) => num(b, 'earned') - num(a, 'earned'),
  };

  function heading(text: string, n: number) {
    const h = document.createElement('h2');
    h.className = 'group-heading';
    h.textContent = `${text} (${n})`;
    return h;
  }

  function render() {
    const q = search.value.trim().toLowerCase();
    const visible = rows
      .filter((r) => !q || r.dataset.name!.includes(q) || r.dataset.franchise!.toLowerCase().includes(q))
            .filter((r) => {
        if (filter === 'ongoing') return r.dataset.ongoing === 'true';
        return filter === 'all' || (filter === 'complete') === (r.dataset.complete === 'true');
      })
      .filter((r) => platform === 'all' || r.dataset.platform === platform)
      .sort(comparators[sort.value]);

    const nodes: HTMLElement[] = [];
    if (group.checked) {
      // Groups appear in the order their best-ranked game does under the current sort.
      const groups = new Map<string, HTMLElement[]>();
      for (const r of visible) {
        const key = r.dataset.franchise || '';
        groups.set(key, [...(groups.get(key) ?? []), r]);
      }
      const standalone = groups.get('') ?? [];
      for (const [key, members] of groups) {
        if (key) nodes.push(heading(key, members.length), ...members);
      }
      if (standalone.length) nodes.push(heading('standalone', standalone.length), ...standalone);
    } else {
      nodes.push(...visible);
    }

    list.replaceChildren(...nodes);
    count.textContent = `showing ${visible.length} of ${rows.length}`;
  }

  search.addEventListener('input', render);
  sort.addEventListener('change', render);
  group.addEventListener('change', render);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      filter = chip.dataset.filter!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      render();
    });
  }
  for (const chip of platformChips) {
    chip.addEventListener('click', () => {
      platform = chip.dataset.platform!;
      platformChips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      render();
    });
  }
  render();
</script>

