---
import Base from '../layouts/Base.astro';
import { getInfo } from '../lib/sheet';

const sections = await getInfo();

// Text with bare URLs -> parts, so links render as real anchors.
const linkify = (text: string) =>
  text.split(/(https?:\/\/\S+)/g).map((part) => ({ part, isUrl: /^https?:\/\//.test(part) }));
---

<Base title="Setup – Kuldz">
  <h1>Setup</h1>

  {sections.map((section) => (
    <section>
      {section.title && <h2>{section.title}</h2>}
      <dl>
        {section.items.map((item) => (
          <>
            <dt>{item.label}</dt>
            <dd>
              {linkify(item.value).map((s) => (s.isUrl ? <a href={s.part} rel="noopener">{s.part}</a> : s.part))}
            </dd>
          </>
        ))}
      </dl>
    </section>
  ))}
</Base>

<style>
  section { margin-top: 1.5rem; }
  h2 { font-size: 0.95rem; color: var(--accent); margin: 0 0 0.5rem; }
  dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 0.4rem 1.5rem; background: var(--card); border-radius: 0.5rem; padding: 0.75rem 1rem; }
  dt { color: var(--muted); font-size: 0.9rem; }
  dd { margin: 0; overflow-wrap: anywhere; }

  @media (max-width: 40rem) {
    dl { grid-template-columns: 1fr; gap: 0; }
    dd { margin-bottom: 0.6rem; }
  }
</style>
